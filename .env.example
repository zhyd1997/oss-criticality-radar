# Copy to .env.local and fill in. Read by Next.js and by services/docker-compose.yml.

# GitHub personal access token (public repo read). Used by the score service / CLI.
GITHUB_AUTH_TOKEN=

# Where the Next.js BFF reaches the score service.
SCORE_SERVICE_URL=http://localhost:8080

# Shared Bearer secret between the BFF and the score service.
SCORE_SERVICE_TOKEN=dev-shared-secret

# Optional: max concurrent criticality_score processes (default 2).
# SCORE_MAX_CONCURRENCY=2
